 #include "amxmodx.h"
 #include "libraries.h"
 
+#if defined(__ANDROID__)
+#include <dlfcn.h>
+#include <sys/stat.h>
+
+static const char *AppNativeLibDir()
+{
+	static char path[1024];
+	Dl_info dli;
+	if (!dladdr((void *)&AppNativeLibDir, &dli) || !dli.dli_fname)
+		return NULL;
+	const char *slash = strrchr(dli.dli_fname, '/');
+	if (!slash)
+		return NULL;
+	size_t len = (size_t)(slash - dli.dli_fname);
+	if (!len || len >= sizeof(path))
+		return NULL;
+	memcpy(path, dli.dli_fname, len);
+	path[len] = '\0';
+	return path;
+}
+
+static const char *BaseNameOf(const char *path)
+{
+	const char *slash = strrchr(path, '/');
+	return slash ? slash + 1 : path;
+}
+
+void *Amxx_LoadModuleFromAppNative(const char *storagePath)
+{
+	const char *dir = AppNativeLibDir();
+	if (!dir)
+		return NULL;
+	char candidate[1024];
+	ke::SafeSprintf(candidate, sizeof(candidate), "%s/lib%s", dir, BaseNameOf(storagePath));
+	dlerror();
+	return dlopen(candidate, RTLD_NOW);
+}
+
+bool Amxx_ModuleExistsInAppNative(const char *storagePath)
+{
+	const char *dir = AppNativeLibDir();
+	if (!dir)
+		return false;
+	char candidate[1024];
+	ke::SafeSprintf(candidate, sizeof(candidate), "%s/lib%s", dir, BaseNameOf(storagePath));
+	struct stat st;
+	return (stat(candidate, &st) == 0 && S_ISREG(st.st_mode));
+}
+#endif
+
 #ifndef FAR
 	#define FAR
 #endif
