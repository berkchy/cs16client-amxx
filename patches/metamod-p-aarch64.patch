diff --git a/metamod/cs16_amxx_compat.h b/metamod/cs16_amxx_compat.h
new file mode 100644
index 0000000..f8df6c2
--- /dev/null
+++ b/metamod/cs16_amxx_compat.h
@@ -0,0 +1,36 @@
+//
+// cs16_amxx_compat.h - CS16Client: SDK type shim for metamod-p's meta_api.h
+//
+// metamod-p's engine_api.h / eiface.h rely on engine API types (int32,
+// uint32, edict_t, sequenceEntry_s, sentenceEntry_s) having been pulled in by
+// the HLSDK headers (extdll.h / archtypes.h / Sequence.h) BEFORE meta_api.h is
+// processed. Consistent with the canonical metamod plugin include order:
+//
+//     #include "extdll.h"
+//     #include "meta_api.h"
+//
+// Consumers such as the AMXX core and AMXX modules include <meta_api.h> on its
+// own, so guarantee the SDK types are visible here instead.
+//
+
+#ifndef _CS16CLIENT_AMXX_COMPAT_H_
+#define _CS16CLIENT_AMXX_COMPAT_H_
+
+#include <extdll.h>
+
+#if defined(__has_include)
+#  if __has_include(<Sequence.h>)
+#    include <Sequence.h>
+#    define _CS16CLIENT_AMXX_COMPAT_SEQ_ 1
+#  endif
+#endif
+
+#ifndef _CS16CLIENT_AMXX_COMPAT_SEQ_
+// SDK does not carry Sequence.h; provide opaque typedefs matching the engine
+// SDK's own declarations so the engine_api.h function-pointer typedefs stay
+// self-contained.
+typedef struct sequenceEntry_ sequenceEntry_s;
+typedef struct sentenceEntry_ sentenceEntry_s;
+#endif
+
+#endif // _CS16CLIENT_AMXX_COMPAT_H_
