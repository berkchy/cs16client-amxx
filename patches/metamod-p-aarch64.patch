 inline void construct_jmp_instruction(void *x, void *place, void* target)
 {
 	unsigned char *p = (unsigned char *)x;
+#if defined(__aarch64__)
+	// AArch64: single unconditional "b" branch (4 bytes / one instruction).
+	// Range +/-128MB, which is fine within a single shared object.
+	unsigned long rel = (unsigned long)target - (unsigned long)place;
+	unsigned int enc = 0x14000000u | ((unsigned int)(rel >> 2) & 0x03FFFFFFu);
+	memcpy(p, &enc, sizeof(enc));
+#else
